{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/generate-caption.js": {
      "maxDuration": 60
    },
    "api/generate-hooks.js": {
      "maxDuration": 60
    },
    "api/generate-this-person.js": {
      "maxDuration": 60
    }
  }
}
